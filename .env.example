# Discord
DISCORD_TOKEN=COLE_SEU_TOKEN_NO_PAINEL
COMMAND_PREFIX=;
# Compatibilidade: usado somente se COMMAND_PREFIX não estiver definido.
DEFAULT_PREFIX=;
ALLOW_BANG_PREFIX=1
# Opcional: ID do servidor de teste para sincronização imediata dos comandos slash.
DEV_GUILD_ID=
# ID do dono do bot (seu user ID Discord). Vários: OWNER_IDS=111,222
OWNER_ID=
OWNER_IDS=
DB_PATH=hellsing.db
# Opcional: imagem HTTPS alternativa para cartas sem imagem própria.
DEFAULT_CARD_IMAGE=

# Texto - cadastre somente as chaves que você possui
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
NVIDIA_API_KEY=
# OpenAI, Groq e Cloudflare Workers AI (texto)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_MODEL=@cf/meta/llama-3.1-8b-instruct
# Opcional: deixe NVIDIA_MODEL vazio para descoberta automática.
NVIDIA_MODEL=
AI_MODEL_PROBE_LIMIT=50
# Tempo máximo por provedor de IA (8 a 300 s). Respostas longas e modelos de raciocínio precisam de mais tempo.
AI_PROVIDER_TIMEOUT_SEC=120
# Prazo total somando todos os provedores do fallback (máx. 840 s, abaixo dos 15 min do Discord).
AI_TOTAL_TIMEOUT_SEC=720

# Imagens - uma ou ambas as chaves podem ser usadas
POLLINATIONS_KEY=
POLLINATIONS_IMAGE_MODEL=black-forest-labs/flux.1-schnell
STABLE_DIFFUSION_KEY=
STABILITY_IMAGE_ENDPOINT=https://api.stability.ai/v2beta/stable-image/generate/core

# Downloads (opcionais)
# gallery-dl é instalado pelo requirements.txt; fotos/carrosséis habilitados para Instagram e TikTok.
MAX_UPLOAD_MB=10
MAX_DURATION_SEC=600
# Opcional: caminhos para cookies no formato Netscape, se a plataforma exigir sessão.
# Nunca coloque o conteúdo dos cookies neste arquivo nem publique o arquivo no GitHub.
YTDLP_COOKIES_INSTAGRAM=
YTDLP_COOKIES_TIKTOK=
YTDLP_COOKIES_TWITTER=



# Opcional: cookies do Pinterest se o download exigir login
YTDLP_COOKIES_PINTEREST=

# --- Logs do console/arquivo ---
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
# Pasta dos arquivos hellsing.log e erros.log (rotação automática 5x5 MB / 3x2 MB)
LOG_DIR=logs
# 1 = grava em arquivo também; 0 = só console
LOG_FILE=1

# --- Social ---
# Fuso horário usado nos anúncios de aniversário
BOT_TZ=America/Sao_Paulo
