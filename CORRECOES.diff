-            log.warning("SQLite ainda não está disponível; painéis antigos não serão restaurados.")
-            return
-        try:
-            await db.execute(
-                "CREATE TABLE IF NOT EXISTS music_player_panels ("
-                "guild_id INTEGER PRIMARY KEY, channel_id INTEGER NOT NULL, "
-                "message_id INTEGER NOT NULL, updated_at INTEGER NOT NULL)"
-            )
-            await db.commit()
-            cursor = await db.execute(
-                "SELECT guild_id, channel_id, message_id FROM music_player_panels"
-            )
-            rows = await cursor.fetchall()
-            for row in rows:
-                guild_id = int(row["guild_id"])
-                channel_id = int(row["channel_id"])
-                message_id = int(row["message_id"])
-                view = MusicPlayerView(self)
