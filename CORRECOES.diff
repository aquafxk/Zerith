-def _resolve_music_query(raw_query: str) -> tuple[str, Optional[str], str]:
-    """Retorna (consulta, prefixo opcional, nome da fonte) para links e aliases."""
-    query = raw_query.strip()
-    if not query:
-        raise ValueError("Informe o nome ou link da música.")
-
-    # Formas aceitas: 'spotify: artista - música' e 'spsearch: artista - música'.
-    alias = re.match(
-        r"^(youtube_music|youtube|soundcloud|spotify|sp|applemusic|apple|deezer|yandex|vk|tidal|qobuz|jiosaavn)\s*:\s*(.+)$",
-        query,
-        re.IGNORECASE,
-    )
-    if alias:
-        key = alias.group(1).casefold()
-        key = {"sp": "spotify"}.get(key, key)
-        prefix, label = MUSIC_PROVIDERS[key]
-        return alias.group(2).strip(), prefix, label
-
-    lowered = query.casefold()
-    for prefix, label in MUSIC_RAW_PREFIXES.items():
-        if lowered.startswith(prefix):
-            return query[len(prefix):].strip(), prefix, label
