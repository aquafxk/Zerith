+    @app_commands.describe(mensagem="Variáveis: {membro} {nome} {idade}", cargo="Cargo dado durante o dia do aniversário")
+    async def aniv_config(
+        self,
+        interaction: discord.Interaction,
+        canal: Optional[discord.TextChannel] = None,
